# ========================================================
# Environment Configuration Template
# Copy this file to .env or .env.production and customize.
# ========================================================

# ========================================================
# 1. Server Configuration
# ========================================================
PORT=5000
NODE_ENV=production

# ========================================================
# 2. Production Docker MongoDB Credentials & Auth
# ========================================================
# In production Docker, MongoDB initializes with an administrative user and password.
# Change these values before deploying!
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_a_strong_password_here
MONGO_DATABASE=vchat

# Optional override: If set, MONGODB_URI takes precedence.
# In Docker Compose, this is automatically constructed as:
# mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongo:27017/${MONGO_DATABASE}?authSource=admin
# MONGODB_URI=mongodb://admin:replace_with_a_strong_password_here@mongo:27017/vchat?authSource=admin

# ========================================================
# 3. Security
# ========================================================
# Generate a cryptographically secure string (e.g. openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_string_in_production

# ========================================================
# 4. Client URL & CORS
# ========================================================
# Production URL (domain or host IP) where your frontend is accessed:
# e.g. https://yourdomain.com or http://localhost:5000
CLIENT_URL=http://localhost:5000

# ========================================================
# 5. Local Development (Alternative without Docker)
# ========================================================
# If running locally using 'npm run dev':
# NODE_ENV=development
# MONGODB_URI=mongodb://localhost:27017/vchat
# CLIENT_URL=http://localhost:5173

