# ========================================================
# Environment Configuration Template
# Copy this file to .env or .env.production on your VPS
# ========================================================

# ========================================================
# 1. Traefik Routing & Domain (Production VPS)
# ========================================================
# The domain/subdomain pointing to your VPS IP:
DOMAIN=chat.yourdomain.com

# Public URL used by frontend & CORS (must match your HTTPS domain):
CLIENT_URL=https://chat.yourdomain.com

# ========================================================
# 2. MongoDB Authentication (Production Docker)
# ========================================================
# Credentials for initializing the secure MongoDB container:
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_a_strong_password_here
MONGO_DATABASE=vchat

# Optional: MONGODB_URI is auto-constructed in Docker Compose using the above credentials:
# mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongo:27017/${MONGO_DATABASE}?authSource=admin
# Set MONGODB_URI only if you wish to override it:
# MONGODB_URI=mongodb://admin:replace_with_a_strong_password_here@mongo:27017/vchat?authSource=admin

# ========================================================
# 3. Application Security & Runtime
# ========================================================
NODE_ENV=production
PORT=5000

# Generate a strong random secret (e.g., openssl rand -base64 32):
JWT_SECRET=replace_with_a_secure_random_string_in_production

# ========================================================
# 4. Local Development (Alternative without Docker/Traefik)
# ========================================================
# If running locally via 'npm run dev':
# NODE_ENV=development
# MONGODB_URI=mongodb://localhost:27017/vchat
# CLIENT_URL=http://localhost:5173
