# Environment Configuration Template
# Copy this file to .env (or backend/.env) and populate with your own values

# Server Settings
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mern-chat-app?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Firebase Cloud Messaging for Push Notifications
# Leave blank if not using push notifications (app will gracefully continue)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
