{
  "name": "v-chat-mern-app",
  "version": "2.0.0",
  "description": "Full-stack real-time communication platform built with React, Node.js, Express, MongoDB, and Socket.IO.",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "server": "node backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm install && npm install --prefix frontend && npm run build --prefix frontend",
    "test": "echo \"Error: no test specified\" && exit 0"
  },
  "keywords": [
    "mern",
    "chat-app",
    "react",
    "nodejs",
    "express",
    "socket-io",
    "mongodb",
    "realtime"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "firebase-admin": "^13.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "vite": "^6.0.6"
  }
}
