# Backend Environment Configuration Template
PORT=5000
NODE_ENV=development

# Database Connection (Docker internal network)
# Use 'mongo' as hostname inside Docker network:
MONGODB_URI=mongodb://mongo:27017/vchat
# (If running outside Docker locally on your machine, use: mongodb://localhost:27017/vchat)

JWT_SECRET=your_jwt_secret_key_change_in_production
CLIENT_URL=http://localhost:5000
